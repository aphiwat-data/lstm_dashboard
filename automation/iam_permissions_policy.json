{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketNamesSoMissingKeysReturn404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::gold-lstm-forecast"
    },
    {
      "Sid": "ReadSilverAndServingModelOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::gold-lstm-forecast/silver/xauusd_daily_clean.parquet",
        "arn:aws:s3:::gold-lstm-forecast/model/serving/*"
      ]
    },
    {
      "Sid": "ReadWriteOnlyItsOwnIsolatedOutputPaths",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::gold-lstm-forecast/bronze/streaming/*",
        "arn:aws:s3:::gold-lstm-forecast/gold/xauusd_daily/predictions/*"
      ]
    },
    {
      "Sid": "OwnCloudWatchLogGroupOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:*:log-group:/aws/lambda/gold-lstm-forecast-daily-refresh:*"
    }
  ]
}
